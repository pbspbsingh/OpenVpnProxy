# Copy this file to config.toml and fill in your own values.
# Relative profile paths are resolved from the directory containing config.toml.
profile_path = "client.ovpn"
username = ""
password = ""
# Listen on all IPv4 interfaces so other machines can use the proxy.
socks5_address = "0.0.0.0:1080"

# Set this only when the VPN server does not provide a usable DNS server.
# dns_override = "1.1.1.1"
