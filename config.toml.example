# Copy this file to config.toml and fill in your own values.
# Listen on all IPv4 interfaces so other machines can use the proxy.
socks5_address = "0.0.0.0:1080"
# Dashboard includes configuration management, activation, and shutdown.
webui_address = "127.0.0.1:8080"
# Recent dashboard log events kept in memory (default 1000, maximum 20000).
# dashboard_log_capacity = 1000
# Optional default VPN, read-only in the dashboard. Without it, add and activate
# a custom entry in Configuration. Restart restores the last active entry using its
# latest saved settings. Headless operation requires that selection or this default.
# Relative profile paths resolve from the directory containing this application TOML file.
# [openvpn_config]
# profile_path = "client.ovpn"
# username = ""
# password = ""
# max_active_vpn_hosts = 16
# Authenticated DNS over TLS for VPN discovery and tunneled destinations.
# Defaults to 1.1.1.1:853; never falls back to plaintext.
# Without dns_tls_name, the certificate must cover the resolver IP.
# dns_override = "1.1.1.1"
# dns_tls_name = "cloudflare-dns.com"
